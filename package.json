{
  "name": "zippy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter @zippy/server db:push",
    "typecheck": "pnpm -r typecheck",
    "share": "node scripts/share.mjs",
    "desktop": "pnpm --filter @zippy/desktop tauri dev"
  },
  "devDependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
