{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zippy",
  "version": "0.1.0",
  "identifier": "com.justaziz.zippy",
  "build": {
    "frontendDist": "../splash",
    "beforeDevCommand": "pnpm --filter @zippy/web exec vite build",
    "beforeBuildCommand": "pnpm bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zippy",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "create": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/**/*"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "zippy"
        ]
      }
    }
  }
}
